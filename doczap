#!/usr/bin/env sh

set -eu

LAUNCHER_PATH=$0
while [ -L "$LAUNCHER_PATH" ]; do
    LINK_TARGET=$(readlink "$LAUNCHER_PATH")
    case "$LINK_TARGET" in
        /*) LAUNCHER_PATH=$LINK_TARGET ;;
        *) LAUNCHER_PATH=$(dirname "$LAUNCHER_PATH")/$LINK_TARGET ;;
    esac
done

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$LAUNCHER_PATH")" && pwd)
DOCZAP_CACHE_DIR=${UV_CACHE_DIR:-${TMPDIR:-/tmp}/doczap-uv-cache}
export UV_CACHE_DIR=$DOCZAP_CACHE_DIR
exec uv run --offline --project "$PROJECT_DIR" python -m doczap "$@"
